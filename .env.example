# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your own key:
#   cp .env.example .env.local
#
# `.env.local` is gitignored and never committed.
# ─────────────────────────────────────────────────────────────

# Vercel AI Gateway API key.
# Get one at: https://vercel.com/dashboard  →  AI Gateway  →  API Keys
# This single key powers BOTH models used by the app:
#   - typesafe-ai/jev      (the decision model)
#   - openai/gpt-5-mini    (the skill extractor)
AI_GATEWAY_API_KEY=your_key_here
